# Copy to .env and fill in real values. .env is gitignored — never commit it.
# chmod 600 .env once populated.

### Two ways to run this ###
# 1. Console-only (default, nothing to uncomment below): bring your own
#    already-running OvenMediaEngine. Point OME_API_BASE_URL/
#    OME_MEDIA_BASE_URL/OME_ACCESS_TOKEN below at that instance, and copy
#    this repo's ome/conf/Server.xml <Managers><API><AccessToken> (and, for
#    AdmissionWebhooks/SignedPolicy/alerting to work, the matching
#    <AdmissionWebhooks>/<SignedPolicy> <SecretKey> values too) into your
#    own OME's config — the console can't manage an instance that doesn't
#    have this wiring. See README.md's "Two ways to run this".
# 2. Combined stack (optional, recommended if you don't have OME yet):
#    uncomment the line below. `docker compose up -d` then also starts the
#    bundled, pre-wired `ome` service from this repo — nothing else to
#    configure, all the OvenMediaEngine section below already matches it.
# COMPOSE_PROFILES=with-ome

### OvenMediaEngine ###
# Only read by the bundled `ome` service (COMPOSE_PROFILES=with-ome above).
# Pin to an exact tag — resolved and verified for Sprint 1. Never "latest".
OME_IMAGE_TAG=v0.21.0

# REQUIRED (combined stack only). The host's real public IP — used in WebRTC
# ICE candidates so playback works for clients off this Docker host (Docker
# NATs the container even though the host itself has a public IP).
# Server.xml's own default (*) will NOT work for real WebRTC clients, only
# for same-host testing.
OME_HOST_IP=203.0.113.10

# REQUIRED either way. Combined stack: also used in Server.xml's
# <Managers><API><AccessToken>. Console-only: set this to whatever token
# your own external OME instance's <AccessToken> already uses. Sent as HTTP
# Basic auth. Generate a new one with: openssl rand -hex 32
OME_ACCESS_TOKEN=

# Console-only mode ONLY (combined stack ignores these — it hardcodes the
# bundled ome service's internal Docker DNS address instead). Point these at
# your own OME instance's real REST API / WebRTC+LLHLS address.
# OME_API_BASE_URL=https://ome.yourdomain.tld:8081
# OME_MEDIA_BASE_URL=https://ome.yourdomain.tld:3333

# Optional overrides — Server.xml's own ${env:VAR:default} defaults already match
# this project's plan (RTMP 1935, SRT 9999, WebRTC+LLHLS+Thumbnail 3333/3334,
# API 8081, ICE range 10000-10009/udp, TCP ICE 10000/tcp, TCP relay 3478).
# Uncomment only to deviate from those defaults. Changing one of these changes
# what port OME listens on *inside* the container — if you need it reachable
# at a different *host* port too, also update the matching entry in
# docker-compose.yml's `ports:`/`expose:` list, which is independent of this.
# OME_API_PORT=8081
# OME_RTMP_PROV_PORT=1935
# OME_SRT_PROV_PORT=9999
# OME_SRT_PUB_PORT=9998
# OME_WEBRTC_SIGNALLING_PORT=3333
# OME_WEBRTC_SIGNALLING_TLS_PORT=3334
# OME_WEBRTC_CANDIDATE_PORT=10000-10009/udp
# OME_WEBRTC_TCP_ICE_PORT=10000/tcp
# OME_WEBRTC_TCP_RELAY_PORT=3478
# OME_LLHLS_STREAM_PORT=3333
# OME_LLHLS_STREAM_TLS_PORT=3334
# OME_THUMBNAIL_PORT=3333

# REQUIRED. Host paths for recordings and VOD/playlist media — on this
# reference deployment these live on a separate large filesystem, but any
# writable host directory works. Created automatically if missing.
RECORDINGS_DIR=./data/recordings
VOD_DIR=./data/vod

# The vhost/app name this console operates against — must match the
# <VirtualHost><Name> / <Application><Name> in ome/conf/Server.xml (both
# default to "default"/"app" via the same ${env:VAR:default} templating
# every port above uses). Sets both, since this console currently supports
# exactly one vhost and one app per server. Normally set for you by the
# setup wizard on first run (visit /setup) rather than by hand.
OME_DEFAULT_VHOST=default
OME_DEFAULT_APP=app

# OPTIONAL. Only needed if you want SignedPolicy viewer links (see
# console/src/app/(console)/access-settings — not needed for anything
# else). Directory name under both the live/ and archive/ cert mounts you'd
# uncomment in docker-compose.yml, e.g. your domain name if using certbot.
# OME_TLS_CERT_NAME=your-domain

### Console (Next.js) ###
# Leave everything in this section blank and just run `docker compose up -d`
# — every request is redirected to a one-time setup wizard at /setup until
# CONSOLE_SETUP_COMPLETE=true below, which the wizard's last step writes
# itself once you've created your first account, connected OME and
# generated CONSOLE_SESSION_SECRET/SIGNED_POLICY_SECRET/
# ADMISSION_WEBHOOK_SECRET/CONSOLE_ENCRYPTION_KEY (strong, random, never
# hand-typed). The wizard then shows you the exact `docker compose up -d`
# to run and a "Check" button — the new values only take effect after that
# restart, same as any other .env change. The vars below are what the
# wizard fills in; only set them by hand if you're scripting an install or
# migrating an existing deployment.
#
# CONSOLE_ADMIN_USER/CONSOLE_ADMIN_PASSWORD_HASH are the older, pre-wizard
# way to seed the first user (still supported): if either is set, the
# wizard is skipped entirely and this becomes the first Engineer account
# instead. CONSOLE_ADMIN_PASSWORD_HASH must be a real bcrypt hash, not a
# plaintext password — generate one with the console image's own bcrypt
# (after `docker compose up -d console` at least once):
#   docker compose exec console node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" yourpassword
CONSOLE_ADMIN_USER=
CONSOLE_ADMIN_PASSWORD_HASH=

# Written by the wizard's final step — do not set this by hand unless
# you're migrating an existing deployment straight to the new config
# without ever visiting /setup (in which case set it alongside a real
# CONSOLE_SESSION_SECRET etc. below, or use CONSOLE_ADMIN_USER instead).
CONSOLE_SETUP_COMPLETE=

# Random long string used to sign session cookies.
CONSOLE_SESSION_SECRET=

# Both secrets MUST exactly match the <SecretKey> values pasted into
# ome/conf/Server.xml's <SignedPolicy> and <AdmissionWebhooks> blocks — the
# console needs to know these to generate valid signed URLs and verify
# incoming webhook signatures itself. Generate with: openssl rand -base64 24
SIGNED_POLICY_SECRET=
ADMISSION_WEBHOOK_SECRET=

# Sprint 7b: alert notifications, sent via SMTP (e.g. a mailbox/app password
# on your own mail server) — email is the only implemented channel so far.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sprint 8b: encrypts the server registry's access tokens at rest (AES-256-GCM).
# 32 raw bytes, base64-encoded. Generate with: openssl rand -base64 32
CONSOLE_ENCRYPTION_KEY=

### Domains — point these at your host's public IP and configure in NPM ###
# Documentation only: neither var is read by docker-compose.yml or the console
# app — NPM's proxy hosts are configured independently. This is just a
# human-readable record of which domains this deployment actually uses.
CONSOLE_DOMAIN=console.yourdomain.tld
MEDIA_DOMAIN=stream.yourdomain.tld
