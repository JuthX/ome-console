<?xml version="1.0" encoding="UTF-8" ?>

<!--
	Based on OvenMediaEngine's own shipped default (airensoft/ovenmediaengine:v0.21.0,
	/opt/ovenmediaengine/bin/origin_conf/Server.xml), extracted and diffed against upstream.
	No secrets are inlined here — everything sensitive comes from ${env:...} substitution,
	sourced from this project's .env via docker-compose. Safe to commit.

	Changes vs. the stock image default, made for OME-Console:
	  - Bind/Managers/API: uncommented, to enable the REST API the console will use.
	  - Bind/Publishers: removed OVT (origin-edge relay, Tier 4/out of scope for now);
	    added Thumbnail, sharing the WebRTC/LLHLS port by default.
	  - Added a top-level <Managers> block (Host + API/AccessToken) required to actually
	    turn on the REST API — the Bind/Managers/API block above only opens the port.
	  - Applications/app/Providers and /Publishers: removed OVT (pull+push) for the same
	    reason as above.
	  - Applications/app/Publishers: added Thumbnail.
	  - OutputProfile/Encodes: added an Image (jpeg) encode so Thumbnail has something to render.

	Running the console against a separate, already-existing OME instance
	instead of this bundled one ("console-only" mode — see README.md's "Two
	ways to run this")? This file is exactly what needs porting into that
	instance's own config: at minimum <Managers><API><AccessToken>, and for
	AdmissionWebhooks/SignedPolicy/alerting to work, matching
	<AdmissionWebhooks>/<SignedPolicy> <SecretKey> values too.
-->
<Server version="8">
	<Name>OvenMediaEngine</Name>
	<!-- Host type (origin/edge) -->
	<Type>origin</Type>
	<!-- Specify IP address to bind (* means all IPs) -->
	<IP>*</IP>
	<PrivacyProtection>false</PrivacyProtection>
	<!--
	To get the public IP address(mapped address of stun) of the local server.
	This is useful when OME cannot obtain a public IP from an interface, such as AWS or docker environment.
	If this is successful, you can use ${PublicIP} in your settings.
	-->
	<StunServer>stun.ovenmediaengine.com:13478</StunServer>

	<Modules>
		<!--
		Currently OME only supports h2 like all browsers do. Therefore, HTTP/2 only works on TLS ports.
		-->
		<HTTP2>
			<Enable>true</Enable>
		</HTTP2>

		<LLHLS>
			<Enable>true</Enable>
		</LLHLS>

		<!-- P2P works only in WebRTC and is experiment feature -->
		<P2P>
			<!-- disabled by default -->
			<Enable>false</Enable>
			<MaxClientPeersPerHostPeer>2</MaxClientPeersPerHostPeer>
		</P2P>

		<!-- jemalloc allocator tuning (effective only in jemalloc builds) -->
		<Jemalloc>
			<!-- Run memory decay/purge on a background thread instead of the allocating thread. Enabled by default. -->
			<BackgroundPurge>true</BackgroundPurge>
		</Jemalloc>

		<!-- Shared worker threads that run short tasks for the modules that need them -->
		<TaskPool>
			<!-- Workers the pool runs on, started with the first task -->
			<ThreadCount>4</ThreadCount>
			<!-- Tasks that may wait to start. Reaching this rejects further tasks. -->
			<MaxTasks>128</MaxTasks>
		</TaskPool>
	</Modules>

	<!-- Settings for the ports to bind -->
	<Bind>
		<!-- REST API server — the OME-Console backend is the only client of this. -->
		<Managers>
			<API>
				<Port>${env:OME_API_PORT:8081}</Port>
				<WorkerCount>1</WorkerCount>
			</API>
		</Managers>
		<Providers>
			<!-- Pull providers -->
			<RTSPC>
				<WorkerCount>1</WorkerCount>
			</RTSPC>
			<!-- Push providers -->
			<RTMP>
				<Port>${env:OME_RTMP_PROV_PORT:1935}</Port>
				<WorkerCount>1</WorkerCount>
			</RTMP>
			<SRT>
				<Port>${env:OME_SRT_PROV_PORT:9999}</Port>
				<WorkerCount>1</WorkerCount>
			</SRT>
			<WebRTC>
				<Signalling>
					<Port>${env:OME_WEBRTC_SIGNALLING_PORT:3333}</Port>
					<TLSPort>${env:OME_WEBRTC_SIGNALLING_TLS_PORT:3334}</TLSPort>
					<WorkerCount>1</WorkerCount>
				</Signalling>
				<IceCandidates>
					<!-- Set OME_HOST_IP to the host's real public IP (Docker NATs the container even though the host itself has a public IP). -->
					<IceCandidate>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_CANDIDATE_PORT:10000-10009/udp}</IceCandidate>
					<!-- Direct TCP ICE (RFC 6544) -->
					<IceCandidate>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_TCP_ICE_PORT:10000/tcp}</IceCandidate>
					<!-- TURN relay for clients that do not support Direct TCP ICE (e.g. restrictive corporate/mobile networks) -->
					<TcpRelay>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_TCP_RELAY_PORT:3478}</TcpRelay>
					<TcpRelayForce>false</TcpRelayForce>
					<TcpIceWorkerCount>1</TcpIceWorkerCount>
					<TcpRelayWorkerCount>1</TcpRelayWorkerCount>
				</IceCandidates>
			</WebRTC>
		</Providers>

		<Publishers>
			<LLHLS>
				<!--
				OME only supports h2, so LLHLS works over HTTP/1.1 on non-TLS port.
				Note that LLHLS runs higher performance over HTTP/2.
				Therefore, it is recommended to use TLS Port.
				-->
				<Port>${env:OME_LLHLS_STREAM_PORT:3333}</Port>
				<TLSPort>${env:OME_LLHLS_STREAM_TLS_PORT:3334}</TLSPort>
				<WorkerCount>1</WorkerCount>
			</LLHLS>
			<Thumbnail>
				<!-- Shares the WebRTC/LLHLS port by default; not exposed on its own separate port. -->
				<Port>${env:OME_THUMBNAIL_PORT:3333}</Port>
			</Thumbnail>
			<WebRTC>
				<Signalling>
					<Port>${env:OME_WEBRTC_SIGNALLING_PORT:3333}</Port>
					<TLSPort>${env:OME_WEBRTC_SIGNALLING_TLS_PORT:3334}</TLSPort>
					<WorkerCount>1</WorkerCount>
				</Signalling>
				<IceCandidates>
					<IceCandidate>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_CANDIDATE_PORT:10000-10009/udp}</IceCandidate>
					<IceCandidate>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_TCP_ICE_PORT:10000/tcp}</IceCandidate>
					<TcpRelay>${env:OME_HOST_IP:*}:${env:OME_WEBRTC_TCP_RELAY_PORT:3478}</TcpRelay>
					<TcpRelayForce>false</TcpRelayForce>
					<TcpIceWorkerCount>1</TcpIceWorkerCount>
					<TcpRelayWorkerCount>1</TcpRelayWorkerCount>
				</IceCandidates>
			</WebRTC>
			<!-- vMix (or any SRT caller) can pull a stream straight from OME instead of
			     the console pushing it out — bind-level only, no per-Application entry
			     (confirmed against OME's own misc/conf_examples/Server.xml on GitHub,
			     unlike WebRTC/LLHLS which do have App-level tuning blocks). Separate
			     port from the SRT *provider* (9999) — providers and publishers are
			     always distinct listeners even for the same protocol. -->
			<SRT>
				<Port>${env:OME_SRT_PUB_PORT:9998}</Port>
				<WorkerCount>1</WorkerCount>
			</SRT>
		</Publishers>
	</Bind>

	<!-- REST API auth/host config — the Bind/Managers/API block above only opens the port; this actually turns the API on. -->
	<Managers>
		<Host>
			<Names>
				<Name>*</Name>
			</Names>
		</Host>
		<API>
			<!-- OME refuses to boot with an empty AccessToken (confirmed: a blank
			     value is a fatal "Empty <AccessToken> is not allowed" error, not
			     a soft warning) — "changeme" is a placeholder that lets a fresh
			     clone boot at all before the setup wizard writes a real one and
			     the container is restarted. Never leave this as "changeme" in a
			     real deployment: it's the entire authentication for OME's API. -->
			<AccessToken>${env:OME_ACCESS_TOKEN:changeme}</AccessToken>
			<CrossDomains>
				<Url>*</Url>
			</CrossDomains>
		</API>
	</Managers>

	<!-- Default Settings for all Virtual Hosts -->
	<Defaults>
		<CrossDomains>
			<Url>*</Url>
		</CrossDomains>
	</Defaults>

	<VirtualHosts>
		<VirtualHost>
			<Name>${env:OME_DEFAULT_VHOST:default}</Name>
			<Distribution>ovenmediaengine.com</Distribution>

			<Host>
				<Names>
					<Name>*</Name>
				</Names>
				<!-- OME's own direct TLS listener — this is the one place OME's own
				     TLS is actually used: SignedPolicy viewer links are signed
				     against this port (3334) directly, bypassing any reverse proxy
				     in front of it, because OME validates a signature against the
				     exact scheme/host/port it itself receives — a TLS-terminating
				     reverse proxy changes those, which silently breaks every signed
				     link (confirmed by a real failed/succeeded test pair against a
				     live instance).
				     Unlike AccessToken above, this element being present with an
				     unloadable cert is FATAL, not a soft failure — OME won't boot
				     at all (confirmed: "Could not create a certificate from file").
				     So docker-compose.yml mounts a bundled, committed self-signed
				     placeholder (ome/certs/self-signed/, matching the "your-domain"
				     default below) by default, purely so a fresh clone boots —
				     replace it with a real cert (Let's Encrypt/certbot or similar)
				     before relying on SignedPolicy for anything real, by setting
				     OME_TLS_CERT_NAME and mounting your own cert at the same path
				     (see .env.example). If using certbot: the directory name under
				     both live/ and archive/ must match — its live/ certs are
				     relative symlinks into archive/ (e.g. ../../archive/<name>/
				     cert1.pem), so renaming just one side of the bind mount breaks
				     the symlink chain. Re-run :reloadCertificate (Hosts & apps page)
				     after a cert renews. -->
				<TLS>
					<CertPath>/etc/letsencrypt/live/${env:OME_TLS_CERT_NAME:your-domain}/cert.pem</CertPath>
					<KeyPath>/etc/letsencrypt/live/${env:OME_TLS_CERT_NAME:your-domain}/privkey.pem</KeyPath>
					<ChainCertPath>/etc/letsencrypt/live/${env:OME_TLS_CERT_NAME:your-domain}/chain.pem</ChainCertPath>
				</TLS>
			</Host>

			<!-- Sprint 7a: viewer links only (PRD Tier 3: Access & keys) — no
			     Providers, so publish/ingest stays unsigned; that side is
			     gated by AdmissionWebhooks below instead. No `thumbnail` in
			     Publishers either, so the console's own /api/thumbnail proxy
			     (a separate media-port JPG fetch) is unaffected.
			     Refer https://ovenmedia.com/docs/ome/access-control/signedpolicy
			     SecretKey is templated from .env's SIGNED_POLICY_SECRET (the setup
			     wizard generates and writes this for you). -->
			<SignedPolicy>
				<PolicyQueryKeyName>policy</PolicyQueryKeyName>
				<SignatureQueryKeyName>signature</SignatureQueryKeyName>
				<SecretKey>${env:SIGNED_POLICY_SECRET:changeme}</SecretKey>
				<Enables>
					<Publishers>webrtc,llhls</Publishers>
				</Enables>
			</SignedPolicy>

			<!-- Sprint 7a: publish keys — OME calls the console live on every
			     RTMP/SRT/WebRTC connection attempt; the console checks the
			     `keys` table and answers allow/deny. SecretKey is templated from
			     .env's ADMISSION_WEBHOOK_SECRET (the setup wizard generates and
			     writes this for you).
			     Refer https://ovenmedia.com/docs/ome/access-control/admission-webhooks -->
			<AdmissionWebhooks>
				<ControlServerUrl>http://console:3000/api/admission-webhook</ControlServerUrl>
				<SecretKey>${env:ADMISSION_WEBHOOK_SECRET:changeme}</SecretKey>
				<Timeout>3000</Timeout>
				<Enables>
					<Providers>rtmp,srt,webrtc</Providers>
				</Enables>
			</AdmissionWebhooks>

			<CrossDomains>
				<Url>*</Url>
			</CrossDomains>

			<Applications>
				<Application>
					<Name>${env:OME_DEFAULT_APP:app}</Name>
					<Type>live</Type>
					<OutputProfiles>
						<OutputProfile>
							<Name>bypass_stream</Name>
							<OutputStreamName>${OriginStreamName}</OutputStreamName>

							<Playlist>
								<Name>default</Name>
								<FileName>master</FileName>
								<Options>
									<WebRtcAutoAbr>true</WebRtcAutoAbr>
									<HLSChunklistPathDepth>0</HLSChunklistPathDepth>
									<EnableTsPackaging>true</EnableTsPackaging>
								</Options>
								<RenditionTemplate>
									<Name>${Height}p</Name>
									<VideoTemplate>
										<EncodingType>all</EncodingType>
									</VideoTemplate>
									<AudioTemplate>
										<EncodingType>all</EncodingType>
									</AudioTemplate>
								</RenditionTemplate>
							</Playlist>

							<Encodes>
								<Video>
									<Name>bypass_video</Name>
									<Bypass>true</Bypass>
								</Video>
								<Audio>
									<Name>aac_audio</Name>
									<Codec>aac</Codec>
									<Bitrate>128000</Bitrate>
									<Samplerate>48000</Samplerate>
									<Channel>2</Channel>
									<BypassIfMatch>
										<Codec>eq</Codec>
									</BypassIfMatch>
								</Audio>
								<Audio>
									<Name>opus_audio</Name>
									<Codec>opus</Codec>
									<Bitrate>128000</Bitrate>
									<Samplerate>48000</Samplerate>
									<Channel>2</Channel>
									<BypassIfMatch>
										<Codec>eq</Codec>
									</BypassIfMatch>
								</Audio>
								<!-- Feeds the Thumbnail publisher below: 1fps JPEG for the multiviewer (PRD Tier 1). -->
								<Image>
									<Codec>jpeg</Codec>
									<Framerate>1</Framerate>
									<Width>1280</Width>
									<Height>720</Height>
								</Image>
							</Encodes>
						</OutputProfile>
					</OutputProfiles>
					<Providers>
						<WebRTC>
							<Timeout>30000</Timeout>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
						</WebRTC>
						<RTMP />
						<SRT />
						<RTSPPull />
						<Schedule>
							<MediaRootDir>/opt/ovenmediaengine/media</MediaRootDir>
							<ScheduleFilesDir>/opt/ovenmediaengine/media</ScheduleFilesDir>
						</Schedule>
						<!-- Sprint 5b: multiplex channels. File-drop .mux creation isn't
						     used (console only calls the REST API), so this directory just
						     needs to exist for the provider to initialize — not bind-mounted. -->
						<Multiplex>
							<MuxFilesDir>/opt/ovenmediaengine/media/mux_files</MuxFilesDir>
						</Multiplex>
					</Providers>
					<Publishers>
						<AppWorkerCount>1</AppWorkerCount>
						<StreamWorkerCount>8</StreamWorkerCount>
						<WebRTC>
							<Timeout>30000</Timeout>
							<Rtx>false</Rtx>
							<Ulpfec>false</Ulpfec>
							<JitterBuffer>false</JitterBuffer>
							<CreateDefaultPlaylist>true</CreateDefaultPlaylist>
						</WebRTC>
						<LLHLS>
							<OriginMode>true</OriginMode>
							<ChunkDuration>0.5</ChunkDuration>
							<!-- PartHoldBack SHOULD be at least three times the Part Target Duration -->
							<PartHoldBack>1.5</PartHoldBack>
							<SegmentDuration>6</SegmentDuration>
							<SegmentCount>10</SegmentCount>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
							<CreateDefaultPlaylist>true</CreateDefaultPlaylist> <!-- llhls.m3u8 -->
						</LLHLS>
						<Thumbnail>
							<CrossDomains>
								<Url>*</Url>
							</CrossDomains>
						</Thumbnail>
						<!-- Lets a caller (vMix, ffplay, etc.) pull a stream straight from OME
						     over SRT instead of the console pushing it out. The bind-level
						     <SRT> block above only opens the listener — OME's own startup log
						     confirmed a real gotcha here: without this per-Application entry
						     too, it logs "SRT publisher is disabled in #default#app
						     application, so it was not created" and never actually serves
						     anything, even though the port is open. -->
						<SRT />
						<!-- Sprint 4: push publishing. No StreamMap — the console always calls
						     :startPush with full explicit params, so OME's own automatic-push
						     matching isn't needed. -->
						<Push />
						<!-- Sprint 4: recording. RootPath lets the console pass relative
						     filePath/infoPath per request; written into the bind-mounted
						     /opt/ovenmediaengine/recordings (see docker-compose.yml), which
						     maps to /home/ovenmediaengine/recordings on the host. -->
						<FILE>
							<RootPath>/opt/ovenmediaengine/recordings</RootPath>
							<FilePath>/${VirtualHost}/${Application}/${Stream}/${StartTime:YYYYMMDDhhmmss}_${EndTime:YYYYMMDDhhmmss}.ts</FilePath>
							<InfoPath>/${VirtualHost}/${Application}/${Stream}/${StartTime:YYYYMMDDhhmmss}_${EndTime:YYYYMMDDhhmmss}.xml</InfoPath>
						</FILE>
					</Publishers>
				</Application>
			</Applications>
		</VirtualHost>
	</VirtualHosts>
</Server>
